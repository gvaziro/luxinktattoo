# Production domain, used for canonical URLs, hreflang, sitemap, Open Graph and JSON-LD.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.ge

# Search engine ownership verification (only the code from the meta tag, not the whole tag).
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster → Add site → Meta tag
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
